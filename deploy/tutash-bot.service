[Unit]
Description=Tutash Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target
# never give up restarting the bot after repeated crashes (this key belongs in [Unit], not [Service])
StartLimitIntervalSec=0

[Service]
User=tutash
Group=tutash
WorkingDirectory=/srv/tutash
EnvironmentFile=/srv/tutash/.env
ExecStart=/srv/tutash/venv/bin/python -m bot.main
Restart=always
RestartSec=5
UMask=0007
# hardening: the bot may only write to its own data
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/tutash

[Install]
WantedBy=multi-user.target
