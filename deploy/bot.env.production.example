# /srv/tutash/.env  (chmod 600, owner tutash)  - copy, then fill in. Never commit the real file.
# from @BotFather (revoke the old token first: it was pasted into a chat)
BOT_TOKEN=
# python3 -c "import secrets;print(secrets.token_hex(32))"  (different from the token)
LINK_SECRET=
PUBLIC_BASE_URL=https://YOUR-DOMAIN
# nginx proxies /f/ to it
WEB_HOST=127.0.0.1
WEB_PORT=8787
LINK_TTL_HOURS=24

DATA_DIR=/srv/tutash/data
UPLOADS_DIR=/srv/tutash/uploads
# after the PostgreSQL move this is replaced by the DB_* settings
DB_PATH=/srv/tutash/bot.db

# 1 = registered users also need approval in the dashboard before getting files
REQUIRE_APPROVAL=0
USER_COOLDOWN=0.7
MAX_PARALLEL_UPLOADS=3
# LOCAL_API_URL=http://127.0.0.1:8081   # only when a local Telegram Bot API server runs (limit 2 GB instead of 50 MB)
