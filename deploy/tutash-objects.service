[Unit]
Description=Tutash: split new or changed street PDFs into design-code objects
# separate from the bot on purpose: page rendering is heavy and must never slow the bot's answers
After=tutash-bot.service

[Service]
Type=oneshot
User=tutash
Group=tutash
WorkingDirectory=/srv/tutash
EnvironmentFile=/srv/tutash/.env
ExecStart=/srv/tutash/venv/bin/python -m bot.objects
UMask=0007
# lowest priority: the bot, nginx and php-fpm always come first
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
CPUQuota=60%
MemoryMax=900M
TimeoutStartSec=3h
