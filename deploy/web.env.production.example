# /srv/tutash/web/.env  (chmod 600, owner www-data)  - copy, then fill in. Never commit the real file.
APP_NAME="Tutash Admin"
APP_ENV=production
# with true, an error page leaks settings and queries to the visitor
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN
# php artisan key:generate
APP_KEY=
APP_LOCALE=uz
LOG_LEVEL=warning

# who may open the panel and the photo/file routes (comma separated). Create them with
#   php artisan make:filament-user      (choose a long random password)
ADMIN_EMAILS=you@example.com
TRUSTED_PROXIES=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# the bot's data (read AND written by the dashboard)
# the same PostgreSQL database as the bot's DATABASE_URL
BOT_DB_DRIVER=pgsql
BOT_DB_HOST=127.0.0.1
BOT_DB_PORT=5432
BOT_DB_DATABASE=tutash
BOT_DB_USERNAME=tutash
BOT_DB_PASSWORD=PASSWORD
BOT_DATA_PATH=/srv/tutash/data
BOT_UPLOADS_PATH=/srv/tutash/uploads
DISPLAY_TIMEZONE=Asia/Tashkent

# the Laravel side's own small database (admin logins, sessions, cache)
DB_CONNECTION=sqlite
CACHE_STORE=database

# District staff Mini App (/tg/app): the bot's token, to check Telegram's initData signature. Same value as BOT_TOKEN in /srv/tutash/.env
TELEGRAM_BOT_TOKEN=
